#!/usr/bin/env bash
set -euo pipefail

cache="${XDG_CACHE_HOME:-$HOME/.cache}/pwnbox/theme"
wal_out="${XDG_CACHE_HOME:-$HOME/.cache}/wal"
mono="$HOME/.config/wal/monochrome"
wall_dir="$HOME/.local/share/pwnbox/wallpapers"
themes_dir="${XDG_CONFIG_HOME:-$HOME/.config}/pwnbox/themes"
state="$cache/wallpaper"
custom_state="$cache/custom-theme"
style_state="$cache/barstyle"
default_wall="$HOME/.config/hypr/wall.png"
picker_cfg="$HOME/.config/rofi/picker.rasi"
barstyle_cfg="$HOME/.config/rofi/barstyle.rasi"
menu_cfg="$HOME/.config/rofi/menu.rasi"
custom_cfg="$HOME/.config/rofi/custom.rasi"
previews_dir="$HOME/.config/quickshell/previews"
thumb_dir="$cache/thumbs"
radius_state="$cache/radius-window"
uir_state="$cache/radius-ui"
blur_file="$cache/blur"
opacity_file="$cache/opacity"
anim_file="$cache/animations"
border_file="$cache/borders"
shadow_file="$cache/shadows"
font_ui_state="$cache/font-ui"
font_app_state="$cache/font-app"
font_ui_size_state="$cache/font-size-ui"
font_app_size_state="$cache/font-size-app"
scale_state="$cache/scale"

font_choices=(
    "Manrope"
    "Fairfax HD"
    "Fairfax Hax HD"
    "Fairfax Pona HD"
    "Fairfax SM HD"
    "Ubuntu"
    "Ubuntu Mono"
    "Spleen 6x12"
    "Spleen 8x16"
    "Spleen 12x24"
    "Spleen 16x32"
    "Terminus (TTF)"
    "Iosevka"
    "Iosevka Nerd Font"
    "Iosevka Nerd Font Mono"
    "Iosevka Nerd Font Propo"
    "JetBrains Mono"
    "JetBrainsMono Nerd Font"
    "JetBrainsMono Nerd Font Mono"
    "JetBrainsMono Nerd Font Propo"
    "MesloLGS Nerd Font"
    "MesloLGS Nerd Font Mono"
    "MesloLGS Nerd Font Propo"
    "FiraCode Nerd Font"
    "FiraCode Nerd Font Mono"
    "FiraCode Nerd Font Propo"
    "Inconsolata"
    "Noto Sans"
    "Noto Sans Mono"
    "Noto Serif"
    "DejaVu Sans"
    "DejaVu Sans Mono"
    "DejaVu Serif"
    "Liberation Sans"
    "Liberation Mono"
    "Liberation Serif"
)

notify() {
    :
}

cp_atomic() {
    local src="$1" dst="$2" tmp
    [ -e "$src" ] || return 0
    tmp="$(dirname -- "$dst")/.$(basename -- "$dst").pwnbox-tmp"
    if cp -f "$src" "$tmp" 2>/dev/null; then
        chmod u+w "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$dst" 2>/dev/null || rm -f "$tmp"
    else
        rm -f "$tmp"
    fi
}

spawn_nice() {
    local fn="$1" pid
    (
        "$fn" >/dev/null 2>&1 &
        pid=$!
        renice -n 10 -p "$pid" >/dev/null 2>&1 || true
    )
}

inplace_sed() {
    local file="$1" tmp
    shift
    [ -f "$file" ] || return 0
    tmp="$(dirname -- "$file")/.$(basename -- "$file").pwnbox-tmp"
    if sed "$@" "$file" >"$tmp" 2>/dev/null; then
        chmod u+w "$file" 2>/dev/null || true
        mv -f "$tmp" "$file" 2>/dev/null || rm -f "$tmp"
    else
        rm -f "$tmp"
    fi
}

read_state() {
    local file="$1" fallback="$2" value
    value="$(cat "$file" 2>/dev/null || true)"
    [ -n "$value" ] || value="$fallback"
    printf '%s' "$value"
}

win_radius() { read_state "$radius_state" 9; }
ui_radius() { read_state "$uir_state" 9; }
blur_state() { read_state "$blur_file" on; }
blur_label() { [ "$(blur_state)" = "off" ] && printf 'Off' || printf 'On'; }
blur_hypr() { [ "$(blur_state)" = "off" ] && printf 'false' || printf 'true'; }
opacity() { read_state "$opacity_file" 100; }
opacity_label() { printf '%s%%' "$(opacity)"; }
opacity_value() {
    local o
    o="$(opacity)"
    printf '%d.%02d' "$((o / 100))" "$((o % 100))"
}
anim_state() { read_state "$anim_file" on; }
anim_label() { [ "$(anim_state)" = "off" ] && printf 'Off' || printf 'On'; }
anim_hypr() { [ "$(anim_state)" = "off" ] && printf 'false' || printf 'true'; }
border_state() { read_state "$border_file" on; }
border_label() { [ "$(border_state)" = "off" ] && printf 'Off' || printf 'On'; }
border_hypr() { [ "$(border_state)" = "off" ] && printf '0' || printf '2'; }
shadow_state() { read_state "$shadow_file" on; }
shadow_label() { [ "$(shadow_state)" = "off" ] && printf 'Off' || printf 'On'; }
shadow_hypr() { [ "$(shadow_state)" = "off" ] && printf 'false' || printf 'true'; }
ui_font() { read_state "$font_ui_state" "Manrope"; }
app_font() { read_state "$font_app_state" "Iosevka Nerd Font Mono"; }
ui_font_size() { read_state "$font_ui_size_state" 9; }
app_font_size() { read_state "$font_app_size_state" 9; }
scale() { read_state "$scale_state" 100; }

theme_color() {
    local key="$1" value
    value="$(sed -nE "s/^var ${key}[[:space:]]*=[[:space:]]*\"#?([0-9a-fA-F]{6})\".*/\1/p" \
        "$HOME/.config/quickshell/Theme.js" 2>/dev/null | head -1)"
    [ -n "$value" ] && printf '%s' "$value" || printf '8a8a8a'
}

apply_ui_radius() {
    local r js rofi
    r="$(ui_radius)"
    js="$HOME/.config/quickshell/Theme.js"
    if [ -f "$js" ]; then
        sed -i -E "s/^var radius([[:space:]]*)=.*/var radius      = ${r};/" "$js" 2>/dev/null || true
    fi
    rofi="$cache/rofi.rasi"
    if [ -f "$rofi" ]; then
        sed -i -E '/^[[:space:]]*radius:[[:space:]]*/d' "$rofi" 2>/dev/null || true
        sed -i -E "0,/^[[:space:]]*\*[[:space:]]*\{/s//&\n    radius: ${r}px;/" "$rofi" 2>/dev/null || true
    fi

    apply_transparency
}

apply_transparency() {
    local js rofi o a aa bg bgalt key val
    js="$HOME/.config/quickshell/Theme.js"
    [ -f "$js" ] || return 0
    o="$(opacity)"
    case "$o" in '' | *[!0-9]*) o=100 ;; esac
    [ "$o" -gt 100 ] && o=100
    a=$((o * 255 / 100))
    aa="$(printf '%02x' "$a")"
    bg="$(theme_color bg)"
    bgalt="$(theme_color bgAlt)"

    local bgA bgAltA
    bgA="$(printf '#%s%s' "$aa" "$bg")"
    bgAltA="$(printf '#%s%s' "$aa" "$bgalt")"
    for pair in "bgA:$bgA" "bgAltA:$bgAltA"; do
        key="${pair%%:*}"
        val="${pair#*:}"
        if grep -q "^var ${key}" "$js" 2>/dev/null; then
            sed -i -E "s/^var ${key}([[:space:]]*)=.*/var ${key} = \"${val}\";/" "$js" 2>/dev/null || true
        else
            printf 'var %s = "%s";\n' "$key" "$val" >>"$js"
        fi
    done

    rofi="$cache/rofi.rasi"
    if [ -f "$rofi" ]; then
        sed -i -E "s/^([[:space:]]*background:[[:space:]]*)#?[0-9a-fA-F]{6}([0-9a-fA-F]{2})?;/\1#${bg}${aa};/" "$rofi" 2>/dev/null || true
        sed -i -E "s/^([[:space:]]*background-alt:[[:space:]]*)#?[0-9a-fA-F]{6}([0-9a-fA-F]{2})?;/\1#${bgalt}${aa};/" "$rofi" 2>/dev/null || true
    fi
}

apply_fonts() {
    local ui app uisize appsize js rofi kitty fuzzel gtk eq zed hl sp
    local zedsize_ui zedsize_buf zed_tmp
    ui="$(ui_font)"
    app="$(app_font)"
    uisize="$(ui_font_size)"
    appsize="$(app_font_size)"
    zedsize_ui="$(awk -v s="$appsize" 'BEGIN { printf "%.1f", s + 4 }')"
    zedsize_buf="$(awk -v s="$appsize" 'BEGIN { printf "%.1f", s + 1.5 }')"

    js="$HOME/.config/quickshell/Theme.js"
    if [ -f "$js" ]; then
        sed -i -E "s/^(var fontFamily[[:space:]]*=[[:space:]]*)\"[^\"]*\"/\1\"${ui}\"/" "$js" 2>/dev/null || true
        sed -i -E "s/^(var fontMono[[:space:]]*=[[:space:]]*)\"[^\"]*\"/\1\"${app}\"/" "$js" 2>/dev/null || true
        sed -i -E "s/^(var fontSize[[:space:]]*=[[:space:]]*).*/\1${uisize};/" "$js" 2>/dev/null || true
    fi

    kitty="$cache/kitty.conf"
    mkdir -p "$cache" 2>/dev/null || true
    [ -f "$kitty" ] || : >"$kitty"
    chmod u+w "$kitty" 2>/dev/null || true
    sed -i '/# pwnbox-fonts-start/,/# pwnbox-fonts-end/d' "$kitty" 2>/dev/null || true
    {
        printf '# pwnbox-fonts-start\n'
        printf 'font_family %s\n' "$app"
        printf 'font_size %s.0\n' "$appsize"
        printf '# pwnbox-fonts-end\n'
    } >>"$kitty" 2>/dev/null || true

    rofi="$cache/rofi.rasi"
    if [ -f "$rofi" ]; then
        chmod u+w "$rofi" 2>/dev/null || true
        sed -i '/\/\* pwnbox-fonts-start \*\//,/\/\* pwnbox-fonts-end \*\//d' "$rofi" 2>/dev/null || true
        {
            printf '/* pwnbox-fonts-start */\n'
            printf '* { font: "%s %s"; }\n' "$ui" "$uisize"
            printf '/* pwnbox-fonts-end */\n'
        } >>"$rofi" 2>/dev/null || true
    fi

    fuzzel="$cache/fuzzel.ini"
    if [ -f "$fuzzel" ]; then
        chmod u+w "$fuzzel" 2>/dev/null || true
        sed -i '/# pwnbox-fonts-start/,/# pwnbox-fonts-end/d' "$fuzzel" 2>/dev/null || true
        {
            printf '# pwnbox-fonts-start\n'
            printf '[main]\nfont=%s:size=%s\n' "$ui" "$uisize"
            printf '# pwnbox-fonts-end\n'
        } >>"$fuzzel" 2>/dev/null || true
    fi

    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface font-name "${ui} ${uisize}" >/dev/null 2>&1 || true
        gsettings set org.gnome.desktop.interface document-font-name "${ui} ${uisize}" >/dev/null 2>&1 || true
    fi
    gtk2="$HOME/.gtkrc-2.0"
    if [ -f "$gtk2" ]; then
        chmod u+w "$gtk2" 2>/dev/null || true
        if grep -q '^gtk-font-name' "$gtk2" 2>/dev/null; then
            sed -i -E "s/^gtk-font-name[[:space:]]*=.*/gtk-font-name=\"${ui} ${uisize}\"/" "$gtk2" 2>/dev/null || true
        else
            printf 'gtk-font-name="%s %s"\n' "$ui" "$uisize" >>"$gtk2" 2>/dev/null || true
        fi
    fi

    equibop_fonts

    zed="$HOME/.config/zed/settings.json"
    if [ ! -s "$zed" ]; then
        mkdir -p "$(dirname -- "$zed")" 2>/dev/null || true
        printf '{}\n' >"$zed" 2>/dev/null || true
    fi
    if [ -f "$zed" ]; then
        if [ -L "$zed" ]; then
            zed_tmp="$(dirname -- "$zed")/.$(basename -- "$zed").pwnbox-tmp"
            if cp -L "$zed" "$zed_tmp" 2>/dev/null; then
                mv -f "$zed_tmp" "$zed" 2>/dev/null || rm -f "$zed_tmp"
            else
                rm -f "$zed_tmp"
            fi
        fi
        chmod u+w "$zed" 2>/dev/null || true
        if command -v jq >/dev/null 2>&1 && jq -e . "$zed" >/dev/null 2>&1; then
            jq --arg uif "$ui" --arg bf "$app" --argjson uis "${zedsize_ui}" --argjson bfs "${zedsize_buf}" \
                '.ui_font_family = $uif
                 | .buffer_font_family = $bf
                 | .ui_font_size = $uis
                 | .buffer_font_size = $bfs
                 | .theme = ((.theme // {}) | if type != "object" then {} else . end | .mode = "dark" | .dark = "Pwnbox")' \
                "$zed" >"$cache/.zed-settings.pwnbox-tmp" 2>/dev/null &&
                cat "$cache/.zed-settings.pwnbox-tmp" >"$zed" 2>/dev/null
            rm -f "$cache/.zed-settings.pwnbox-tmp" 2>/dev/null || true
        else
            inplace_sed "$zed" -E \
                -e "s/(\"ui_font_family\"[[:space:]]*:[[:space:]]*)\"[^\"]*\"/\1\"${ui}\"/" \
                -e "s/(\"buffer_font_family\"[[:space:]]*:[[:space:]]*)\"[^\"]*\"/\1\"${app}\"/" \
                -e "s/(\"ui_font_size\"[[:space:]]*:[[:space:]]*)[0-9.]+/\1${zedsize_ui}/" \
                -e "s/(\"buffer_font_size\"[[:space:]]*:[[:space:]]*)[0-9.]+/\1${zedsize_buf}/"
        fi
    fi

    hl="$HOME/.config/hypr/hyprlock.conf"
    if [ -f "$hl" ]; then
        sed -i -E "s/^([[:space:]]*font_family[[:space:]]*=[[:space:]]*).*/\1${ui}/" "$hl" 2>/dev/null || true
    fi

    printf 'set font "%s" %s\n' "$app" "$appsize" >"$cache/zathura.conf" 2>/dev/null || true

    sp="$HOME/.scripts/pwnbox-spotify"
    if [ -x "$sp" ]; then
        "$sp" fonts >/dev/null 2>&1 || true
    fi

    sync_ida_theme
    sync_ida_reg
    sync_ida_clr
    sync_obsidian
    sync_signal
    sync_element
    sync_wire
    sync_simplex
    sync_telegram_fonts
}

restart_quickshell() {
    local tries=0
    command -v qs >/dev/null 2>&1 || return 0

    pkill -f 'bin/quickshell -n$' 2>/dev/null || true
    while pgrep -f 'bin/quickshell -n$' >/dev/null 2>&1 && [ "$tries" -lt 40 ]; do
        sleep 0.1
        tries=$((tries + 1))
    done

    tries=0
    while [ "$tries" -lt 4 ]; do
        setsid qs -n >/dev/null 2>&1 &
        sleep 0.5
        pgrep -f 'bin/quickshell -n$' >/dev/null 2>&1 && return 0
        tries=$((tries + 1))
        sleep 0.4
    done
}

reload_fonts() {
    pkill -USR1 kitty 2>/dev/null || true
    restart_quickshell
}

seed_monochrome() {
    mkdir -p "$cache"
    local f
    for f in "$mono"/*; do
        [ -e "$f" ] || continue
        cp_atomic "$f" "$cache/$(basename -- "$f")"
    done
    sync_quickshell "$mono/Theme.js"
}

sync_quickshell() {
    local src="$1"
    [ -f "$src" ] || return 0
    mkdir -p "$HOME/.config/quickshell" 2>/dev/null || true
    cp -f "$src" "$HOME/.config/quickshell/Theme.js" 2>/dev/null || true
    chmod u+w "$HOME/.config/quickshell/Theme.js" 2>/dev/null || true
}

sync_zed() {
    local src="$1"
    [ -f "$src" ] || return 0
    mkdir -p "$HOME/.config/zed/themes" 2>/dev/null || true
    cp -f "$src" "$HOME/.config/zed/themes/pwnbox.json" 2>/dev/null || true
    chmod u+w "$HOME/.config/zed/themes/pwnbox.json" 2>/dev/null || true
}

ida_home() {
    printf '%s' "${PWNBOX_IDA_HOME:-$HOME/Software/RE/IDA}"
}

ida_palette() {
    local nv="$cache/nvim-palette.lua" key="$1" fb="$2" v
    v="$(sed -nE "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"#?([0-9a-fA-F]{6})\".*/\1/p" "$nv" 2>/dev/null | head -1)"
    [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$fb"
}

sync_ida_theme() {
    local ida_home tdir src tmp f fg dim faint accent bg
    ida_home="$(ida_home)"
    src="$cache/ida-theme.css"
    [ -f "$src" ] || return 0

    tdir="$HOME/.idapro/themes/pwnbox"
    mkdir -p "$tdir/icons" "$tdir/extra" 2>/dev/null || return 0

    tmp="$cache/.ida-theme.css.pwnbox-tmp"
    perl -pe 's{rgba\(#([0-9a-fA-F]{6}),([0-9.]+)\)}{ my ($h,$a)=($1,$2); "rgba(" . join(", ", map { hex($_) } $h =~ m/../g) . ",$a)" }eg' \
        "$src" 2>/dev/null |
        sed -e 's/{{/{/g' -e 's/}}/}/g' >"$tmp"
    if [ -s "$tmp" ]; then
        cp -f "$tmp" "$tdir/theme.css" 2>/dev/null || true
        chmod u+w "$tdir/theme.css" 2>/dev/null || true
    fi
    rm -f "$tmp"

    fg="$(ida_palette fg cccccc)"
    dim="$(ida_palette color7 cccccc)"
    faint="$(ida_palette color8 353535)"
    accent="$(ida_palette color4 999999)"
    bg="$(ida_palette bg 080808)"

    local tpl="$HOME/.config/pwnbox/ida/icons" rel
    [ -d "$tpl" ] || return 0
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        rel="${f#"$tpl"/}"
        case "$rel" in
        extra/*) ;;
        *) rel="icons/$rel" ;;
        esac
        sed -e "s/@@FG@@/#$fg/g" -e "s/@@DIM@@/#$dim/g" \
            -e "s/@@FAINT@@/#$faint/g" -e "s/@@ACCENT@@/#$accent/g" \
            -e "s/@@BG@@/#$bg/g" "$f" >"$tdir/$rel" 2>/dev/null || true
        chmod u+w "$tdir/$rel" 2>/dev/null || true
    done < <(find "$tpl" -type f -name '*.svg' 2>/dev/null)
    chmod -R u+w "$tdir" 2>/dev/null || true

    if [ -d "$ida_home" ] && mkdir -p "$ida_home/themes/pwnbox" 2>/dev/null; then
        cp -a "$tdir/." "$ida_home/themes/pwnbox/" 2>/dev/null || true
        chmod -R u+w "$ida_home/themes/pwnbox" 2>/dev/null || true
    fi
}

sync_ida_reg() {
    local reg="$HOME/.idapro/ida.reg" patch="$HOME/.scripts/pwnbox-ida-reg"
    [ -f "$reg" ] || return 0
    [ -x "$patch" ] || return 0
    pgrep -x ida >/dev/null 2>&1 && return 0
    command -v python3 >/dev/null 2>&1 || return 0
    python3 "$patch" "$reg" \
        --theme pwnbox \
        --mono-font "$(app_font)" --mono-size "$(app_font_size)" \
        --ui-font "$(ui_font)" --ui-size "$(ui_font_size)" >/dev/null 2>&1 || true
}

sync_ida_clr() {
    local clr="$HOME/.idapro/cfg/pwnbox.clr" nv="$cache/nvim-palette.lua"
    [ -d "$HOME/.idapro" ] || return 0
    [ -f "$nv" ] || return 0
    mkdir -p "$HOME/.idapro/cfg" 2>/dev/null || true

    read_slot() {
        sed -nE "s/^[[:space:]]*${1}[[:space:]]*=[[:space:]]*\"#?([0-9a-fA-F]{6})\".*/\1/p" \
            "$nv" 2>/dev/null | head -1
    }
    local bg c0 c1 c2 c3 c4 c5 c6 c7 c8 c12 c13 c14 c15
    bg="$(read_slot bg)"
    [ -n "$bg" ] || bg=080808
    c0="$(read_slot color0)"
    [ -n "$c0" ] || c0=171717
    c1="$(read_slot color1)"
    [ -n "$c1" ] || c1=6b6b6b
    c2="$(read_slot color2)"
    [ -n "$c2" ] || c2=c4c4c4
    c3="$(read_slot color3)"
    [ -n "$c3" ] || c3=999999
    c4="$(read_slot color4)"
    [ -n "$c4" ] || c4=999999
    c5="$(read_slot color5)"
    [ -n "$c5" ] || c5=717171
    c6="$(read_slot color6)"
    [ -n "$c6" ] || c6=8a8a8a
    c7="$(read_slot color7)"
    [ -n "$c7" ] || c7=cccccc
    c8="$(read_slot color8)"
    [ -n "$c8" ] || c8=353535
    c12="$(read_slot color12)"
    [ -n "$c12" ] || c12=999999
    c13="$(read_slot color13)"
    [ -n "$c13" ] || c13=717171
    c14="$(read_slot color14)"
    [ -n "$c14" ] || c14=8a8a8a
    c15="$(read_slot color15)"
    [ -n "$c15" ] || c15=ffffff

    bgr() {
        local h="${1:-808080}"
        printf '0x%s%s%s' "${h:4:2}" "${h:2:2}" "${h:0:2}"
    }

    {
        printf '; pwnbox color theme (generated from the active pywal palette)\n'
        printf '; values are 0xBBGGRR\n\n'
        printf 'Instruction        = %s\n' "$(bgr "$c7")"
        printf 'GeneralReg         = %s\n' "$(bgr "$c14")"
        printf 'SegmentReg         = %s\n' "$(bgr "$c7")"
        printf 'Immediate          = %s\n' "$(bgr "$c6")"
        printf 'Data               = %s\n' "$(bgr "$c7")"
        printf 'Regular            = %s\n' "$(bgr "$c15")"
        printf 'Comment            = %s\n' "$(bgr "$c8")"
        printf 'RepeatCmt          = %s\n' "$(bgr "$c8")"
        printf 'Autocmt            = %s\n' "$(bgr "$c8")"
        printf 'Name               = %s\n' "$(bgr "$c4")"
        printf 'DummyName          = %s\n' "$(bgr "$c13")"
        printf 'DemangledName      = %s\n' "$(bgr "$c15")"
        printf 'Punctuation        = %s\n' "$(bgr "$c7")"
        printf 'Chrlit             = %s\n' "$(bgr "$c2")"
        printf 'Strlit             = %s\n' "$(bgr "$c2")"
        printf 'Numlit             = %s\n' "$(bgr "$c6")"
        printf 'VoidOpnd           = %s\n' "$(bgr "$c1")"
        printf 'CodeXref           = %s\n' "$(bgr "$c3")"
        printf 'DataXref           = %s\n' "$(bgr "$c6")"
        printf 'CodeXrefToTail     = %s\n' "$(bgr "$c1")"
        printf 'DataXrefToTail     = %s\n' "$(bgr "$c3")"
        printf 'Error              = %s\n' "$(bgr "$c1")"
        printf 'LinePrefix         = %s\n' "$(bgr "$c8")"
        printf 'OpcodeByte         = %s\n' "$(bgr "$c8")"
        printf 'ExtraLine          = %s\n' "$(bgr "$c14")"
        printf 'AltOpnd            = %s\n' "$(bgr "$c13")"
        printf 'Hidden             = %s\n' "$(bgr "$c3")"
        printf 'Libfunc            = %s\n' "$(bgr "$c6")"
        printf 'Locvar             = %s\n' "$(bgr "$c2")"
        printf 'CodeName           = %s\n' "$(bgr "$c4")"
        printf 'UnknownName        = %s\n' "$(bgr "$c13")"
        printf 'CollapsedLine      = %s\n' "$(bgr "$c3")"
        printf 'AsmDir             = %s\n' "$(bgr "$c5")"
        printf 'Macro              = %s\n' "$(bgr "$c13")"
        printf 'DChrlit            = %s\n' "$(bgr "$c2")"
        printf 'DStrlit            = %s\n' "$(bgr "$c2")"
        printf 'DNumlit            = %s\n' "$(bgr "$c6")"
        printf 'Keyword            = %s\n' "$(bgr "$c12")"
        printf 'Reg                = %s\n' "$(bgr "$c14")"
        printf 'Custmem            = %s\n' "$(bgr "$c8")"
        printf 'DlgBkColor         = %s\n' "$(bgr "$c0")"
        printf 'DlgFgColor         = %s\n' "$(bgr "$c15")"
        printf 'Insensitive        = %s\n' "$(bgr "$c8")"
        printf 'MainWindow         = %s\n' "$(bgr "$c0")"
        printf 'MainWindowFgColor  = %s\n' "$(bgr "$c15")"
        printf 'SelItem            = %s\n' "$(bgr "$c8")"
        printf 'GraphBg            = %s\n' "$(bgr "$bg")"
        printf 'CurFunc            = %s\n' "$(bgr "$c3")"
    } >"$clr" 2>/dev/null || true
    chmod u+w "$clr" 2>/dev/null || true
}

obsidian_vault() {
    printf '%s' "${PWNBOX_OBSIDIAN_VAULT:-$HOME/Documents/Notes}"
}

sync_obsidian() {
    local vault css nv bg bgalt fg fgdim faint accent c1 c2 radius ui app appjson tmp
    vault="$(obsidian_vault)"
    [ -d "$vault/.obsidian" ] || return 0
    nv="$cache/nvim-palette.lua"
    [ -f "$nv" ] || return 0

    bg="$(ida_palette bg 080808)"
    bgalt="$(ida_palette color0 171717)"
    fg="$(ida_palette fg cccccc)"
    mix_hex "#$bg" "#$fg" 72
    fgdim="$MIX_RESULT"
    mix_hex "#$bg" "#$fg" 48
    faint="$MIX_RESULT"
    accent="$(ida_palette accent 999999)"
    c1="$(ida_palette color1 6b6b6b)"
    c2="$(ida_palette color2 c4c4c4)"
    border="$(lighten_hex "$bg" 12)"
    borderh="$(lighten_hex "$bg" 20)"
    radius="$(ui_radius)"
    case "$radius" in '' | *[!0-9]*) radius=9 ;; esac

    mkdir -p "$vault/.obsidian/snippets" 2>/dev/null || return 0
    css="$vault/.obsidian/snippets/pwnbox.css"
    {
        printf '/* pwnbox snippet (generated from the active palette) */\n'
        printf 'body.theme-dark,\nbody.theme-light {\n'
        printf '  --background-primary: #%s;\n' "$bg"
        printf '  --background-primary-alt: #%s;\n' "$bg"
        printf '  --background-secondary: #%s;\n' "$bgalt"
        printf '  --background-secondary-alt: #%s;\n' "$bgalt"
        printf '  --background-tertiary: #%s;\n' "$bgalt"
        printf '  --background-modifier-border: %s;\n' "$border"
        printf '  --background-modifier-border-hover: %s;\n' "$borderh"
        printf '  --background-modifier-border-focus: #%s;\n' "$accent"
        printf '  --background-modifier-box-shadow: none;\n'
        printf '  --background-modifier-hover: #%s;\n' "$bgalt"
        printf '  --background-modifier-active-hover: #%s;\n' "$faint"
        printf '  --background-modifier-form-field: #%s;\n' "$bgalt"
        printf '  --background-modifier-error: #%s;\n' "$c1"
        printf '  --text-normal: #%s;\n' "$fg"
        printf '  --text-muted: #%s;\n' "$fgdim"
        printf '  --text-faint: #%s;\n' "$faint"
        printf '  --text-error: #%s;\n' "$c1"
        printf '  --text-accent: #%s;\n' "$accent"
        printf '  --text-accent-hover: #%s;\n' "$fg"
        printf '  --text-on-accent: #%s;\n' "$bg"
        printf '  --text-highlight-bg: #%s;\n' "$faint"
        printf '  --text-selection: #%s;\n' "$faint"
        printf '  --interactive-normal: #%s;\n' "$bgalt"
        printf '  --interactive-hover: #%s;\n' "$faint"
        printf '  --interactive-accent: #%s;\n' "$accent"
        printf '  --interactive-accent-hover: #%s;\n' "$fg"
        printf '  --code-background: #%s;\n' "$bgalt"
        printf '  --inline-code: #%s;\n' "$c2"
        printf '  --checkbox-color: #%s;\n' "$accent"
        printf '  --checkbox-border-color: #%s;\n' "$fgdim"
        printf '  --checklist-done-color: #%s;\n' "$accent"
        printf '  --list-marker-color: #%s;\n' "$accent"
        printf '  --tag-background: #%s;\n' "$bgalt"
        printf '  --tag-color: #%s;\n' "$fgdim"
        printf '  --blockquote-border-color: #%s;\n' "$accent"
        printf '  --bold-color: #%s;\n' "$fg"
        printf '  --italic-color: #%s;\n' "$fg"
        printf '  --link-color: #%s;\n' "$accent"
        printf '  --link-external-color: #%s;\n' "$accent"
        printf '  --h1-color: #%s;\n' "$fg"
        printf '  --h2-color: #%s;\n' "$fg"
        printf '  --h3-color: #%s;\n' "$fg"
        printf '  --h4-color: #%s;\n' "$fg"
        printf '  --h5-color: #%s;\n' "$fg"
        printf '  --h6-color: #%s;\n' "$fg"
        printf '  --table-border-color: %s;\n' "$border"
        printf '  --table-header-border-color: %s;\n' "$borderh"
        printf '  --modal-border-color: %s;\n' "$border"
        printf '  --prompt-border-color: %s;\n' "$border"
        printf '  --divider-color: %s;\n' "$border"
        printf '  --graph-line: #%s;\n' "$faint"
        printf '  --graph-node: #%s;\n' "$fgdim"
        printf '  --graph-node-tag: #%s;\n' "$accent"
        printf '  --icon-color: #%s;\n' "$fg"
        printf '  --icon-color-hover: #%s;\n' "$fg"
        printf '  --icon-color-active: #%s;\n' "$accent"
        printf '  --icon-color-focused: #%s;\n' "$accent"
        printf '  --icon-opacity: 1;\n'
        printf '  --radius-s: %spx;\n' "$radius"
        printf '  --radius-m: %spx;\n' "$radius"
        printf '  --radius-l: %spx;\n' "$radius"
        printf '  --shadow-s: none;\n  --shadow-m: none;\n  --shadow-l: none;\n'
        printf '}\n'
    } >"$css.tmp" 2>/dev/null || {
        rm -f "$css.tmp"
        return 0
    }
    if ! cmp -s "$css.tmp" "$css" 2>/dev/null; then
        cat "$css.tmp" >"$css"
    fi
    rm -f "$css.tmp"

    appjson="$vault/.obsidian/appearance.json"
    [ -f "$appjson" ] || printf '{}\n' >"$appjson" 2>/dev/null || return 0
    if command -v jq >/dev/null 2>&1; then
        ui="$(ui_font)"
        app="$(app_font)"
        tmp="$vault/.obsidian/.appearance.pwnbox-tmp"
        if jq --arg uif "$ui" --arg appf "$app" \
            '.theme = "obsidian"
             | .cssTheme = ""
             | .interfaceFontFamily = $uif
             | .textFontFamily = $uif
             | .monospaceFontFamily = $appf
             | .enabledCssSnippets = (((.enabledCssSnippets // []) + ["pwnbox"]) | unique)' \
            "$appjson" >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
            mv -f "$tmp" "$appjson"
        else
            rm -f "$tmp"
        fi
    fi
}

zen_chrome_dir() {
    local profiles ini p
    profiles="${XDG_CONFIG_HOME:-$HOME/.config}/zen"
    ini="$profiles/profiles.ini"
    [ -f "$ini" ] || return 1
    p="$(sed -n 's/^Path=//p' "$ini" | head -n1)"
    [ -n "$p" ] || return 1
    printf '%s' "$profiles/$p/chrome"
}

unpin_extensions() {
    local profiles ini p prefs
    command -v python3 >/dev/null 2>&1 || return 0
    pgrep -x zen >/dev/null 2>&1 && return 0
    profiles="${XDG_CONFIG_HOME:-$HOME/.config}/zen"
    ini="$profiles/profiles.ini"
    [ -f "$ini" ] || return 0
    p="$(sed -n 's/^Path=//p' "$ini" | head -n1)"
    [ -n "$p" ] || return 0
    prefs="$profiles/$p/prefs.js"
    [ -f "$prefs" ] || return 0
    python3 - "$prefs" <<'PYEOF' || true
import json
import re
import sys

ids = [
    "uBlock0@raymondhill.net",
    "{d19a89b9-76c1-4a61-bcd4-49e8de916403}",
    "{036a55b4-5e72-4d05-a06c-cba2dfcc134a}",
    "wappalyzer@crunchlabz.com",
    "pywalfox@frewacom.org",
    "{74145f27-f039-47ce-a470-a662b129930a}",
    "kern@skuntir.com",
]
widgets = [i.lower() + "-browser-action" for i in ids]
widgets = [re.sub(r"[^a-z0-9_-]", "_", w) for w in widgets]

path = sys.argv[1]
with open(path) as f:
    text = f.read()

m = re.search(r'user_pref\("browser\.uiCustomization\.state",\s*"(.*?)"\);', text)
if not m:
    sys.exit(0)
raw = m.group(1)
try:
    state = json.loads(json.loads('"' + raw + '"'))
except Exception:
    sys.exit(0)

placements = state.get("placements")
if not isinstance(placements, dict):
    sys.exit(0)
nav = placements.get("nav-bar")
area = placements.get("unified-extensions-area")
if not isinstance(nav, list) or not isinstance(area, list):
    sys.exit(0)

changed = False
for w in widgets:
    while w in nav:
        nav.remove(w)
        changed = True
    if w not in area:
        area.append(w)
        changed = True
if not changed:
    sys.exit(0)

new = json.dumps(state, separators=(",", ":"), ensure_ascii=False)
new = new.replace("\\", "\\\\").replace('"', '\\"')
text = text[: m.start(1)] + new + text[m.end(1):]
with open(path, "w") as f:
    f.write(text)
PYEOF
}

zen_json_color() {
    sed -nE "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"#?([0-9a-fA-F]{6})\".*/\1/p" \
        "$2" 2>/dev/null | head -1
}

zen_palette() {
    local wal="$wal_out/colors.json" pwn="$cache/colors.json"
    local bg="" fg="" c0="" c1="" c2="" c3="" c4="" c5="" c6="" c7="" c8="" key
    if [ -f "$wal" ]; then
        bg="$(zen_json_color background "$wal")"
        fg="$(zen_json_color foreground "$wal")"
        for key in 0 1 2 3 4 5 6 7 8; do
            eval "c$key=\$(zen_json_color color$key \"\$wal\")"
        done
    fi
    if [ -f "$pwn" ]; then
        [ -n "$bg" ] || bg="$(zen_json_color bg "$pwn")"
        [ -n "$fg" ] || fg="$(zen_json_color fg "$pwn")"
        [ -n "$c0" ] || c0="$(zen_json_color bgAlt "$pwn")"
        [ -n "$c4" ] || c4="$(zen_json_color accent "$pwn")"
        [ -n "$c8" ] || c8="$(zen_json_color fgFaint "$pwn")"
    fi
    [ -n "$bg" ] || bg="080808"
    [ -n "$fg" ] || fg="cccccc"
    [ -n "$c0" ] || c0="$bg"
    [ -n "$c4" ] || c4="$fg"
    [ -n "$c8" ] || c8="353535"
    [ -n "$c1" ] || c1="$c4"
    [ -n "$c2" ] || c2="$fg"
    [ -n "$c3" ] || c3="$c8"
    [ -n "$c5" ] || c5="$c4"
    [ -n "$c6" ] || c6="$c8"
    [ -n "$c7" ] || c7="$fg"
    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$bg" "$fg" "$c0" "$c1" "$c2" "$c3" "$c4" "$c5" "$c6" "$c7" "$c8"
}

