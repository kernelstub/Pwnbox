{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pwnbox",
  "author": "pwnbox",
  "themes": [
    {
      "name": "Pwnbox",
      "appearance": "dark",
      "style": {
        "background": "{background}",
        "foreground": "{foreground}",
        "players": [
          {
            "background": "{background}",
            "cursor": "{color6}",
            "selection": "{color8}40"
          }
        ],
        "border": "{color0}",
        "border.variant": "{color0}",
        "border.focused": "{color0}",
        "border.selected": "{color0}",
        "border.transparent": "{color0}80",
        "border.disabled": "{color0}80",

        "elevated_surface.background": "{color0}",
        "surface.background": "{background}",

        "element.background": "{color0}",
        "element.hover": "{color8}40",
        "element.active": "{color8}80",
        "element.selected": "{color8}80",
        "element.disabled": "{color0}40",

        "ghost_element.background": "{background}00",
        "ghost_element.hover": "{color8}40",
        "ghost_element.active": "{color8}80",
        "ghost_element.selected": "{color8}80",
        "ghost_element.disabled": "{color0}40",

        "drop_target.background": "{color8}80",

        "text": "{foreground}",
        "text.muted": "{color7}",
        "text.placeholder": "{color7}",
        "text.disabled": "{color8}",
        "text.accent": "{color6}",
        "icon": "{foreground}",
        "icon.muted": "{color7}",
        "icon.disabled": "{color8}",
        "icon.placeholder": "{color7}",
        "icon.accent": "{color6}",
        "link_text.hover": "{color6}",

        "created": "{color2}",
        "created.background": "{color0}",
        "created.border": "{color0}",
        "modified": "{color3}",
        "modified.background": "{color0}",
        "modified.border": "{color0}",
        "deleted": "{color1}",
        "deleted.background": "{color0}",
        "deleted.border": "{color0}",
        "renamed": "{color6}",
        "renamed.background": "{color0}",
        "renamed.border": "{color0}",
        "conflict": "{color3}",
        "conflict.background": "{color0}",
        "conflict.border": "{color0}",
        "hidden": "{color8}",
        "hidden.background": "{color0}",
        "hidden.border": "{color0}",
        "ignored": "{color8}",
        "ignored.background": "{color0}",
        "ignored.border": "{color0}",
        "info": "{color6}",
        "info.background": "{color0}",
        "info.border": "{color0}",
        "warning": "{color3}",
        "warning.background": "{color0}",
        "warning.border": "{color0}",
        "error": "{color1}",
        "error.background": "{color0}",
        "error.border": "{color0}",
        "hint": "{color5}",
        "hint.background": "{color0}",
        "hint.border": "{color0}",
        "predictive": "{color8}",
        "predictive.background": "{color0}",
        "predictive.border": "{color0}",
        "success": "{color2}",
        "success.background": "{color0}",
        "success.border": "{color0}",
        "unreachable": "{color8}",
        "unreachable.background": "{color0}",
        "unreachable.border": "{color0}",

        "pane.focused_border": "{color0}",
        "pane_group.border": "{color0}",
        "panel.background": "{background}",
        "panel.focused_border": "{color0}",
        "editor.indent_guide": "{color8}",
        "editor.indent_guide_active": "{color7}",
        "panel.indent_guide": "{color8}",
        "panel.indent_guide_active": "{color7}",
        "panel.indent_guide_hover": "{foreground}",
        "scrollbar.thumb.background": "{color8}",
        "scrollbar.thumb.hover_background": "{color7}",
        "scrollbar.thumb.border": "{color0}",
        "scrollbar.track.background": "{background}00",
        "scrollbar.track.border": "{color0}",
        "search.match_background": "{color4}80",
        "search.active_match_background": "{color3}80",
        "tab_bar.background": "{background}",
        "tab.active_background": "{background}",
        "tab.inactive_background": "{background}",
        "tab.active_foreground": "{foreground}",
        "tab.inactive_foreground": "{color7}",
        "toolbar.background": "{background}",
        "status_bar.background": "{background}",
        "title_bar.background": "{background}",
        "title_bar.inactive_background": "{background}",
        "editor.background": "{background}",
        "editor.foreground": "{foreground}",
        "editor.gutter.background": "{background}",
        "editor.line_number": "{color8}",
        "editor.active_line_number": "{foreground}",
        "editor.active_line.background": "{color0}80",
        "editor.highlighted_line.background": "{color0}",
        "editor.subheader.background": "{color0}",
        "editor.invisible": "{color8}",
        "editor.wrap_guide": "{color0}",
        "editor.active_wrap_guide": "{color7}",
        "editor.document_highlight.read_background": "{color8}40",
        "editor.document_highlight.write_background": "{color8}60",
        "editor.document_highlight.bracket_background": "{color6}40",
        "terminal.background": "{background}",
        "terminal.foreground": "{foreground}",
        "terminal.bright_foreground": "{color15}",
        "terminal.dim_foreground": "{color8}",
        "terminal.ansi.background": "{background}",
        "terminal.ansi.black": "{color0}",
        "terminal.ansi.red": "{color1}",
        "terminal.ansi.green": "{color2}",
        "terminal.ansi.yellow": "{color3}",
        "terminal.ansi.blue": "{color4}",
        "terminal.ansi.magenta": "{color5}",
        "terminal.ansi.cyan": "{color6}",
        "terminal.ansi.white": "{color7}",
        "terminal.ansi.bright_black": "{color8}",
        "terminal.ansi.bright_red": "{color9}",
        "terminal.ansi.bright_green": "{color10}",
        "terminal.ansi.bright_yellow": "{color11}",
        "terminal.ansi.bright_blue": "{color12}",
        "terminal.ansi.bright_magenta": "{color13}",
        "terminal.ansi.bright_cyan": "{color14}",
        "terminal.ansi.bright_white": "{color15}",
        "terminal.ansi.dim_black": "{color0}",
        "terminal.ansi.dim_red": "{color1}",
        "terminal.ansi.dim_green": "{color2}",
        "terminal.ansi.dim_yellow": "{color3}",
        "terminal.ansi.dim_blue": "{color4}",
        "terminal.ansi.dim_magenta": "{color5}",
        "terminal.ansi.dim_cyan": "{color6}",
        "terminal.ansi.dim_white": "{color7}",
        "syntax": {
          "comment": { "color": "{color8}", "font_style": "italic" },
          "comment.doc": { "color": "{color8}", "font_style": "italic" },
          "string": { "color": "{color2}" },
          "string.escape": { "color": "{color6}" },
          "number": { "color": "{color3}" },
          "boolean": { "color": "{color3}" },
          "constant": { "color": "{color3}" },
          "variable": { "color": "{foreground}" },
          "variable.special": { "color": "{color1}" },
          "property": { "color": "{foreground}" },
          "function": { "color": "{color6}" },
          "function.method": { "color": "{color6}" },
          "constructor": { "color": "{color5}" },
          "type": { "color": "{color5}" },
          "keyword": { "color": "{color4}" },
          "operator": { "color": "{color7}" },
          "punctuation": { "color": "{color7}" },
          "punctuation.bracket": { "color": "{color7}" },
          "tag": { "color": "{color4}" },
          "attribute": { "color": "{color3}" },
          "title": { "color": "{foreground}", "font_weight": 700 },
          "emphasis": { "color": "{foreground}", "font_style": "italic" },
          "strong": { "color": "{foreground}", "font_weight": 700 },
          "link_text": { "color": "{color6}" },
          "link_uri": { "color": "{color6}" },
          "embedded": { "color": "{foreground}" }
        }
      }
    }
  ]
}
