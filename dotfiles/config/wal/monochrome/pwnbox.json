{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pwnbox",
  "author": "pwnbox",
  "themes": [
    {
      "name": "Pwnbox",
      "appearance": "dark",
      "style": {
        "background": "#080808",
        "foreground": "#cccccc",
        "players": [
          {
            "background": "#080808",
            "cursor": "#8a8a8a",
            "selection": "#35353540"
          }
        ],
        "border": "#171717",
        "border.variant": "#171717",
        "border.focused": "#171717",
        "border.selected": "#171717",
        "border.transparent": "#17171780",
        "elevated_surface_background": "#171717",
        "surface_background": "#080808",
        "element_background": "#171717",
        "element_hover": "#35353540",
        "element_active": "#35353580",
        "element_selected": "#35353580",
        "element_disabled": "#17171740",
        "ghost_element_background": "#08080800",
        "ghost_element_hover": "#35353540",
        "ghost_element_active": "#35353580",
        "ghost_element_selected": "#35353580",
        "ghost_element_disabled": "#17171740",
        "text": "#cccccc",
        "text.muted": "#cccccc",
        "text.placeholder": "#cccccc",
        "text.disabled": "#353535",
        "text.accent": "#8a8a8a",
        "icon": "#cccccc",
        "icon.muted": "#cccccc",
        "icon.disabled": "#353535",
        "icon.placeholder": "#cccccc",
        "icon.accent": "#8a8a8a",
        "drop_target_background": "#35353580",
        "created": "#c4c4c4",
        "modified": "#999999",
        "deleted": "#6b6b6b",
        "conflict": "#999999",
        "conflict.background": "#171717",
        "conflict.border": "#171717",
        "hidden": "#353535",
        "hidden.background": "#171717",
        "hidden.border": "#171717",
        "ignored": "#353535",
        "ignored.background": "#171717",
        "ignored.border": "#171717",
        "info": "#8a8a8a",
        "info.background": "#171717",
        "info.border": "#171717",
        "warning": "#999999",
        "warning.background": "#171717",
        "warning.border": "#171717",
        "error": "#6b6b6b",
        "error.background": "#171717",
        "error.border": "#171717",
        "hint": "#717171",
        "hint.background": "#171717",
        "hint.border": "#171717",
        "predictive": "#353535",
        "predictive.background": "#171717",
        "predictive.border": "#171717",
        "panel.background": "#080808",
        "panel.focused_border": "#171717",
        "editor.indent_guide": "#353535",
        "editor.indent_guide_active": "#cccccc",
        "panel.indent_guide": "#353535",
        "panel.indent_guide_active": "#cccccc",
        "panel.indent_guide_hover": "#cccccc",
        "scrollbar.thumb.background": "#353535",
        "scrollbar.thumb.hover_background": "#cccccc",
        "scrollbar.thumb.border": "#171717",
        "scrollbar.track.background": "#08080800",
        "scrollbar.track.border": "#171717",
        "search.match_background": "#99999980",
        "search.active_match_background": "#99999980",
        "tab_bar.background": "#080808",
        "tab.active_background": "#080808",
        "tab.inactive_background": "#080808",
        "tab.active_foreground": "#cccccc",
        "tab.inactive_foreground": "#cccccc",
        "toolbar.background": "#080808",
        "status_bar.background": "#080808",
        "title_bar.background": "#080808",
        "title_bar.inactive_background": "#080808",
        "editor.background": "#080808",
        "editor.foreground": "#cccccc",
        "editor.gutter.background": "#080808",
        "editor.line_number": "#353535",
        "editor.active_line_number": "#cccccc",
        "editor.highlighted_line_background": "#171717",
        "editor.document_highlight.read_background": "#35353540",
        "editor.document_highlight.write_background": "#35353560",
        "editor.document_highlight.bracket_background": "#8a8a8a40",
        "terminal.background": "#080808",
        "terminal.foreground": "#cccccc",
        "terminal.ansi.black": "#171717",
        "terminal.ansi.red": "#6b6b6b",
        "terminal.ansi.green": "#c4c4c4",
        "terminal.ansi.yellow": "#999999",
        "terminal.ansi.blue": "#999999",
        "terminal.ansi.magenta": "#717171",
        "terminal.ansi.cyan": "#8a8a8a",
        "terminal.ansi.white": "#cccccc",
        "terminal.ansi.bright_black": "#353535",
        "terminal.ansi.bright_red": "#6b6b6b",
        "terminal.ansi.bright_green": "#c4c4c4",
        "terminal.ansi.bright_yellow": "#999999",
        "terminal.ansi.bright_blue": "#999999",
        "terminal.ansi.bright_magenta": "#717171",
        "terminal.ansi.bright_cyan": "#8a8a8a",
        "terminal.ansi.bright_white": "#ffffff",
        "syntax": {
          "comment": { "color": "#353535", "font_style": "italic" },
          "comment.doc": { "color": "#353535", "font_style": "italic" },
          "string": { "color": "#c4c4c4" },
          "string.escape": { "color": "#8a8a8a" },
          "number": { "color": "#999999" },
          "boolean": { "color": "#999999" },
          "constant": { "color": "#999999" },
          "variable": { "color": "#cccccc" },
          "variable.special": { "color": "#6b6b6b" },
          "property": { "color": "#cccccc" },
          "function": { "color": "#8a8a8a" },
          "function.method": { "color": "#8a8a8a" },
          "constructor": { "color": "#717171" },
          "type": { "color": "#717171" },
          "keyword": { "color": "#999999" },
          "operator": { "color": "#cccccc" },
          "punctuation": { "color": "#cccccc" },
          "punctuation.bracket": { "color": "#cccccc" },
          "tag": { "color": "#999999" },
          "attribute": { "color": "#999999" },
          "title": { "color": "#cccccc", "font_weight": 700 },
          "emphasis": { "color": "#cccccc", "font_style": "italic" },
          "strong": { "color": "#cccccc", "font_weight": 700 },
          "link_text": { "color": "#8a8a8a" },
          "link_uri": { "color": "#8a8a8a" },
          "embedded": { "color": "#cccccc" }
        }
      }
    }
  ]
}
