{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/pwnbox.png",
        "width": 25,
        "padding": {
            "top": 0
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "format": ""
        },
        {
            "key": "distro ",
            "type": "os"
        },
        {
            "key": "kernel ",
            "type": "kernel"
        },
        {
            "key": "WM     ",
            "type": "wm"
        },
        {
            "key": "term   ",
            "type": "terminal"
        },
        {
            "key": "shell  ",
            "type": "shell"
        },
        {
            "key": "disk   ",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "memory ",
            "type": "memory"
        },
        {
            "key": "ip     ",
            "type": "localip"
        },
        {
            "key": "uptime ",
            "type": "uptime"
        },
        {
            "key": "pkgs   ",
            "type": "packages"
        },
        {
            "type": "colors",
            "symbol": "square"
        }
    ]
}
