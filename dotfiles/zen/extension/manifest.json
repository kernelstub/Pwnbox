{
    "manifest_version": 2,
    "name": "pwnbox styles",
    "version": "1.3.0",
    "browser_specific_settings": {
        "gecko": { "id": "kern@skuntir.com" }
    },
    "permissions": [
        "<all_urls>",
        "storage",
        "unlimitedStorage",
        "http://localhost:8311/*"
    ],
    "background": { "scripts": ["background.js"] },
    "browser_action": {
        "default_title": "pwnbox styles",
        "default_popup": "popup.html"
    },
    "options_ui": { "page": "options.html", "open_in_tab": true },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}
